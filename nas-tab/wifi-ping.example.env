# wifi-ping.py settings. Copy to collector/wifi-ping.env (or pass --config).
# Pick Wi-Fi devices that are always on and answer ping reliably (smart speakers, smart plugs, a hub...).
# Test them first: `for i in $(seq 15); do ping -c1 -W1 192.168.1.20 >/dev/null && echo ok || echo MISS; sleep 2; done`
# and drop any device that misses even once.
WITNESSES=192.168.1.20=Smart speaker 1,192.168.1.21=Smart speaker 2,192.168.1.22=Smart plug,192.168.1.23=Camera,192.168.1.24=Robot vacuum
# How many witnesses must be silent at the same time to count an outage (default: half, rounded up)
THRESHOLD=3
# The router: pinged too, to tell "Wi-Fi only" from "the whole router" in the notes
GATEWAY=192.168.1.1
INTERVAL=10
STATE_FILE=/var/lib/nas-tab/wifi-ping.json
LOG_FILE=/var/lib/nas-tab/outages-wifi.jsonl
KEEP_DAYS=120
