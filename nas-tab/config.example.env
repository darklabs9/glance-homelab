# nas-state.py settings. Copy to collector/config.env (or point NAS_TAB_CONFIG / --config at it).
# Real environment variables win over this file. Everything except OUTPUT is optional.

# Where the JSON goes: the Glance assets folder (comma-separated list for several copies)
OUTPUT=/srv/glance/assets/nas-state.json
# Cache + update history
STATE_DIR=/var/lib/nas-tab

# --- names shown on the map
HOST_LABEL=NAS
# HOST_IP=192.168.1.10            # default: the IP of the default route
ISP_LABEL=Internet
ROUTER_LABEL=Router
ROUTER_IP=192.168.1.1
# Shorten LAN IPs on the container chips: 192.168.1.42 -> .42
SHORT_IP_PREFIX=192.168.1.
# IPs starting with this are "LAN" addresses (macvlan / ipvlan containers)
LAN_PREFIX=192.168.

# --- containers
# Optional catalogue (groups, names, descriptions, attached databases). Without it: Docker labels nas-tab.* or "Other".
CATALOGUE=/opt/nas-tab/catalogue.json
# Optional: map container IPs to their https://host from a Caddyfile (reverse_proxy <ip>:<port>)
# CADDYFILE=/srv/caddy/Caddyfile
# CADDY_HOST_SUFFIX=.example.lan
# "Logs" button on the container sheet; {name} = container name (e.g. Dozzle)
LOGS_URL=https://dozzle.example.lan/
# Containers matching this regex are attached to the service of their compose project
# DB_PATTERN=postgres|redis|valkey|mariadb|mysql|mongo|-db$
# Optional list of available updates written by your own checker (format in the README)
# UPDATES_FILE=/var/lib/nas-tab/updates.json

# --- system
# Volume used for the disk tile (UGOS / Synology: /volume1)
DATA_PATH=/
DISK_WARN_PCT=85
CPU_HOT_C=85
# NUT UPS (upsc). Leave empty if you have no UPS. UPS_COMMAND can wrap it, e.g. "docker exec nut upsc {name}"
# UPS_NAME=ups@localhost
# UPS_COMMAND=upsc {name}
# UPS_NOTE=clean shutdown below 15 %
# Speedtest Tracker (or any JSON with download/upload/ping), file path or URL
# SPEEDTEST_JSON=http://192.168.1.10:8765/api/speedtest/latest

# --- backup (pick one, or none)
# Kopia running in a container: last snapshot of KOPIA_SOURCE
# KOPIA_CONTAINER=kopia
# KOPIA_SOURCE=/data
# Or any backup tool: a file your backup script touches when it succeeds
# BACKUP_STAMP_FILE=/var/lib/backup/last-success
BACKUP_LABEL=Offsite backup
BACKUP_MAX_AGE_H=30

# --- scheduled tasks
CRON_DIRS=/etc/cron.d
# Debian/Ubuntu without a dedicated cron log: /var/log/syslog
CRON_LOG=/var/log/cron.log
CRON_IGNORE=e2scrub_all,php,sysstat
# cron.d file names flagged "key"
KEY_TASKS=backup,nas-state

# --- outages (each source is optional; a type without a source is hidden on the page)
# Wi-Fi: written by wifi-ping.py
WIFI_OUTAGE_LOG=/var/lib/nas-tab/outages-wifi.jsonl
WIFI_OUTAGE_STATE=/var/lib/nas-tab/wifi-ping.json
# Internet: wifi-ping.py pointed at public IPs, or any watchdog log ("2026-11-01 21:05:10 DOWN" / "... UP")
# NET_OUTAGE_LOG=/var/lib/nas-tab/outages-net.jsonl
# NET_OUTAGE_STATE=/var/lib/nas-tab/net-ping.json
# Power: a UPS watcher log, same text format
# POWER_OUTAGE_LOG=/var/log/ups-watch.log
# Words that mark the start / end of an outage in text logs (regex, case-insensitive). Per type: NET_DOWN_RE, POWER_UP_RE...
# OUTAGE_DOWN_RE=^DOWN\b
# OUTAGE_UP_RE=^UP\b
# OUTAGE_BOOT_RE=^BOOT\b
# e.g. for NUT upsmon NOTIFYCMD lines: POWER_DOWN_RE=on battery   POWER_UP_RE=on line power

# --- "Links" block: Name|URL;Name|URL
LINKS=Uptime Kuma|https://uptime.example.lan;Dozzle|https://dozzle.example.lan;Beszel|https://beszel.example.lan
