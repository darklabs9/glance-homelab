# Copy to .env and fill in. Never commit .env.

# Mealie base URL as seen from the container
MEALIE_URL=http://192.168.1.10:9000
# Mealie API token (User profile > API Tokens)
MEALIE_TOKEN=YOUR_MEALIE_API_TOKEN
# Id (UUID) of the shopping list to expose: open the list in Mealie, it is the last part of the URL
MEALIE_LIST_ID=YOUR_SHOPPING_LIST_UUID

# Optional
# VAPID_SUBJECT=mailto:you@example.com
# BASE_PATH=/grocery
# POLL_INTERVAL=120
# ADDED_NOTE=added from phone
# OTHER_AISLE=Other
# AISLE_ICONS={"Bakery":"🥖","Produce":"🥕","Dairy":"🧀"}
# CATALOG=/config/catalog.json
# DATA_DIR=/data
# PORT=8080
