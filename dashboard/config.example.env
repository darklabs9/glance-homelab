# Copy to scripts/config.env (read by every script), or point DASHBOARD_ENV to another path.
# Real environment variables win over this file. Keep the real file out of git: it holds API keys.

# ---------- common ----------
TZ=Europe/Brussels
# Your location (weather, sky drawing, rain radar). Example: central Brussels.
LAT=50.85
LON=4.35
# Host path that Glance serves as /assets (assets-path in glance.yml). Scripts write JSON to <ASSETS_DIR>/data
# and images to <ASSETS_DIR>/posters.
ASSETS_DIR=/srv/glance/assets
HA_URL=http://homeassistant.local:8123
# Long-lived access token (HA profile > Security)
HA_TOKEN=
# Address you open Home Assistant with in the browser (links from the To do card)
HA_PUBLIC_URL=https://homeassistant.example.lan

# ---------- weather_hours.py ----------
HA_WEATHER_ENTITY=weather.forecast_home
# buienradar (Belgium / Netherlands / Luxembourg only) or none
RAIN_RADAR=none
# Official warnings from MeteoAlarm (optional): country feed + area names as written in the feed (comma separated)
METEOALARM_FEED=https://feeds.meteoalarm.org/feeds/meteoalarm-legacy-atom-belgium
METEOALARM_AREAS=Brussels
METEOALARM_GEOCODES=

# ---------- agenda_days.py ----------
AGENDA_CALENDARS=calendar.personal,calendar.holidays
# calendars shown in grey (public / school holidays...)
AGENDA_OTHER_CALENDARS=calendar.holidays
AGENDA_DAYS=5
AGENDA_HORIZON_DAYS=35

# ---------- home.py ----------
# Rooms: name|temperature entity|humidity entity (optional)|emoji (optional), separated by ;
ROOMS=Living room|sensor.living_room_temperature|sensor.living_room_humidity|🛋;Bedroom|sensor.bedroom_temperature|sensor.bedroom_humidity|🛏
HOME_WEBHOOK_ID=
TODO_ENTITY=todo.chores
VACUUM_ENTITY=vacuum.robot
VACUUM_LAST_CLEAN_ENTITY=sensor.robot_last_cleaning
VACUUM_REMIND_DAYS=3
# regex on entity_id: rechargeable devices left out of the low battery check
BATTERY_EXCLUDE=phone|watch|robot
# Paperless-ngx inbox count (optional)
PAPERLESS_URL=http://192.168.1.10:8000
PAPERLESS_TOKEN=
PAPERLESS_PUBLIC_URL=https://paperless.example.lan
PAPERLESS_INBOX_LINK=https://paperless.example.lan/documents?tags__id__all=1
# Mealie shopping list count for the Groceries button (optional; first list when MEALIE_LIST_ID is empty)
MEALIE_URL=http://192.168.1.10:9000
MEALIE_TOKEN=
MEALIE_LIST_ID=

# ---------- appliance_stats.py / meters.py ----------
# CSV written by the Home Assistant package (path as seen from where the script runs)
APPLIANCE_LOGS=/srv/homeassistant/config/appliances.csv
CURRENCY=€
# Home Assistant database (SQLite, opened read-only) for the meter statistics
HA_DB=/srv/homeassistant/config/home-assistant_v2.db
# key|label|unit, separated by ; (entities: input_number.meter_<key>, sensor.meter_<key>)
METERS=water|Water|m³;gas|Gas|m³;elec_day|Electricity day|kWh;elec_night|Electricity night|kWh
# optional CSV of older readings: date;water;gas;elec_day;elec_night
METERS_CSV=

# ---------- media.py / downloads.py / media_news.py / ratings.py ----------
JELLYFIN_URL=http://192.168.1.10:8096
JELLYFIN_KEY=
# your Jellyfin user id (Dashboard > Users > click the user: id in the address bar)
JELLYFIN_USER_ID=
JELLYFIN_PUBLIC_URL=https://jellyfin.example.lan
SONARR_URL=http://192.168.1.10:8989
SONARR_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_KEY=
SEERR_URL=http://192.168.1.10:5055
SEERR_KEY=
SEERR_PUBLIC_URL=https://jellyseerr.example.lan
MEDIA_WEBHOOK_ID=
# language of titles from Jellyseerr (en, fr, de...)
MEDIA_LANGUAGE=en
# free key from omdbapi.com (1000 requests/day)
OMDB_KEY=
# TV news feeds: name|url separated by ; (default: Screen Rant, TVLine, Rotten Tomatoes, Decider, CBR)
NEWS_FEEDS=

# ===================================================================================================
# Glance container environment (glance.yml uses ${NAME}). Put these in the env of the Glance container,
# e.g. an env_file in docker compose. They are NOT read by the scripts.
# ===================================================================================================
# DATA_URL=http://127.0.0.1:8080/assets/data      # how Glance fetches the JSON (from inside its container)
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# HOME_WEBHOOK_ID=
# METERS_WEBHOOK_ID=
# MEDIA_WEBHOOK_ID=
# PAPERLESS_SEARCH_URL=https://paperless.example.lan/search/documents.html
# GROCERY_URL=https://grocery.example.lan/
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.lan
# SEERR_PUBLIC_URL=https://jellyseerr.example.lan
# CURRENCY=€
