# lab-state.py settings. Copy to collector/config.env (or point LAB_TAB_CONFIG / --config at it).
# Real environment variables win over this file. Everything except OUTPUT and CATALOGUE is optional.

# Where the JSON goes (comma-separated list for several copies). nas.js reads it from data-src.
OUTPUT=/app/assets/data/lab-state.json
# Groups and services; see catalogue.example.json
CATALOGUE=/opt/lab-tab/catalogue.json

# --- health checks: one GET per catalogue "health" URL, in parallel, no credentials sent
PROBE_TIMEOUT=5
PROBE_WORKERS=16

# --- Pulse summary (pulse-kiosk /api/summary): nodes, guests, storage, alerts, Uptime Kuma
# PULSE_SUMMARY_URL=http://192.168.1.30:18082/api/summary

# --- NUT UPS (read with LIST VAR, no login)
# NUT_HOST=192.168.1.40
# NUT_UPS=ups
# UPS_NOTE=clean shutdown below 20 %

# --- GitLab pipeline schedules as "Scheduled tasks" (token with read_api only)
# GITLAB_API=https://gitlab.example.lan/api/v4
# GITLAB_PROJECT=group/project
# GITLAB_TOKEN=

# --- names on the map (defaults: Pulse title, node names)
# HOST_LABEL=My cluster
# HOST_IP=node1 .10 · node2 .11
ISP_LABEL=Internet
ROUTER_LABEL=Router
ROUTER_IP=192.168.1.1
SHORT_IP_PREFIX=192.168.1.
# "Logs" button on a service sheet; {name} = catalogue container id
# LOGS_URL=https://logs.example.lan/search?q={name}

# --- "Links" block: Name|URL;Name|URL
LINKS=Pulse|https://pulse.example.lan;Uptime Kuma|https://uptime.example.lan;Proxmox|https://pve.example.lan:8006
