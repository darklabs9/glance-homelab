# arr-notify.py settings. Copy to config.env next to the script (or pass --config FILE / set ARR_NOTIFY_CONFIG).
# Real environment variables win over this file. Keep this file readable by root only (chmod 600): it holds API keys.

# ntfy server and topics
NTFY_URL=http://ntfy.example.lan
# Topic your phone subscribes to
NTFY_TOPIC=homelab
# Topic Sonarr/Radarr publish to (nobody subscribes to it)
NTFY_SOURCE_TOPIC=homelab-arr
# Only if your ntfy server needs auth
# NTFY_TOKEN=tk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Poster lookup (leave the keys empty to send without posters, or set POSTERS=0)
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
POSTERS=1

STATE_FILE=/var/lib/arr-notify/state.json

# Timings (minutes)
HOLD_FAILURE_MIN=15
SONARR_QUIET_MIN=20
SONARR_MAX_WAIT_MIN=60
RADARR_QUIET_MIN=3
RADARR_MAX_WAIT_MIN=15

# Optional: a lock file your image updater holds (flock) while it runs; health failures during an update wait for it
# UPDATE_LOCK_FILE=/run/lock/container-update.lock
# Optional: small JSON written on each run, if you monitor that the script is alive
# HEARTBEAT_FILE=/var/lib/arr-notify/heartbeat.json
